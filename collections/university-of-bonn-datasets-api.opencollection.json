{
  "opencollection": "1.0.0",
  "info": {
    "name": "bonndata Dataverse Native REST API (Public Read Subset) Datasets API",
    "version": "6.7.1"
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a dataset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bonndata.uni-bonn.de/api/datasets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Numeric dataset id, or the literal \":persistentId\"."
              },
              {
                "name": "persistentId",
                "value": "",
                "type": "query",
                "description": "Persistent identifier (DOI/Handle) when id is \":persistentId\"."
              },
              {
                "name": "returnOwners",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a published dataset by its numeric database id, or by persistent identifier using the literal path segment \":persistentId\" together with the persistentId query parameter (e.g. /datasets/:persistentId/?persistentId=doi:10.60507/FK2/BBP6GG)."
        },
        {
          "info": {
            "name": "List dataset versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bonndata.uni-bonn.de/api/datasets/:id/versions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "excludeFiles",
                "value": "",
                "type": "query"
              },
              {
                "name": "excludeMetadataBlocks",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List dataset versions"
        },
        {
          "info": {
            "name": "Export dataset metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bonndata.uni-bonn.de/api/datasets/export",
            "params": [
              {
                "name": "persistentId",
                "value": "",
                "type": "query",
                "description": "Persistent identifier (DOI/Handle) of the dataset."
              },
              {
                "name": "exporter",
                "value": "",
                "type": "query",
                "description": "Export format name."
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Export the metadata of a published dataset in a chosen format (e.g. Datacite, dataverse_json, oai_dc, schema.org, ddi)."
        }
      ]
    }
  ],
  "bundled": true
}