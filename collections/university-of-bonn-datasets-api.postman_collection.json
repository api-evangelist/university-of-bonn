          "name": "Get a dataset",
          "request": {
            "name": "Get a dataset",
            "description": {
              "content": "Retrieve a published dataset by its numeric database id, or by persistent identifier using the literal path segment \":persistentId\" together with the persistentId query parameter (e.g. /datasets/:persistentId/?persistentId=doi:10.60507/FK2/BBP6GG).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasets",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "persistentId",
                  "value": "<string>",
                  "description": "Persistent identifier (DOI/Handle) when id is \":persistentId\"."
                },
                {
                  "disabled": false,
                  "key": "returnOwners",
                  "value": "<boolean>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Numeric dataset id, or the literal \":persistentId\"."
